# 快期 / 天勤认证（TqAuth）
TQ_USER=你的快期账户
TQ_PASS=你的账户密码

# 期货公司实盘（TqAccount）
TQ_BROKER=Y银河期货
TQ_FUTURE_ACCOUNT=资金账号
TQ_FUTURE_PASSWORD=交易密码

# LLMQuant Data MCP（Skills 数据层）
# 在 https://llmquantdata.com 注册 → Dashboard → API Keys 生成
LLMQUANT_API_KEY=

# 可选：行情校验
# TQ_SYMBOL=SHFE.ni2607
# TQ_VERIFY_UPDATES=5

# Supabase PostgreSQL（可选；仅本地 .env，禁止提交真实密码）
# 推荐 Session pooler（IPv4），例如亚太：
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# 直连 db.*.supabase.co:5432 在许多网络仅 IPv6，容易失败。
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require
# 可选：登录用户 UUID，云同步写入 owner_id（RLS 读模型）
# SUPABASE_OWNER_ID=00000000-0000-0000-0000-000000000000
#
# 座舱读路径（默认 cloud：托管/家里观看端只读 Supabase 投影）
# SIM_DATA_SOURCE=cloud
# 本机调试读 data/runtime/*.sqlite：
# SIM_DATA_SOURCE=local
#
# 常驻托管（只读座舱，不依赖笔记本开着）：
#   docker build -t ignitequant-cockpit .
#   docker run --rm -p 8787:8787 -e DATABASE_URL=... -e SIM_DATA_SOURCE=cloud ignitequant-cockpit
#   浏览器打开 http://HOST:8787/#/sim
# 详见 docs/data_sovereignty_c.md「常驻托管只读座舱」
# SUPABASE_DB_HOST=db.xxxxx.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
#
# 应用 L3–L4 参考/研究表 + 产品租户表 + 座舱投影：
#   python tools/apply_supabase_schema.py
#   python tools/apply_supabase_schema.py --only sim_cockpit_projections
# 本地交易 outbox → 云端：模拟盘进程会自动同步（心跳/收盘）。
# 手动补推：
#   PYTHONPATH=src python tools/sync_outbox_to_supabase.py --db data/runtime/falcon_au_sim.sqlite
# 历史一次回填到投影表（换机后家里空白时）：
#   PYTHONPATH=src python tools/backfill_sim_projections_to_supabase.py --db data/runtime/falcon_au_sim.sqlite
# 历史 K 线（market_cache）→ Supabase market_bar_archive：
#   PYTHONPATH=src python tools/upload_market_cache_to_supabase.py --ids au,ag,rb,fg
# 云端 K 线 → 本地 market_cache：
#   PYTHONPATH=src python tools/download_market_cache_from_supabase.py --ids au,ag,rb,fg
# 若本地无 CSV，先拉：
#   python tools/download_market_cache.py --ids au,ag,rb,fg --start 2024-01-01 --end 2025-12-31
# SQL：supabase/migrations/
# 数据主权：docs/data_sovereignty_c.md
