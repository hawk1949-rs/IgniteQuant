# 快期 / 天勤认证（TqAuth）
TQ_USER=你的快期账户
TQ_PASS=你的账户密码

# 期货公司实盘（TqAccount）
TQ_BROKER=Y银河期货
TQ_FUTURE_ACCOUNT=资金账号
TQ_FUTURE_PASSWORD=交易密码

# LLMQuant Data MCP（Skills 数据层）
# 在 https://llmquantdata.com 注册 → Dashboard → API Keys 生成
LLMQUANT_API_KEY=

# 可选：行情校验
# TQ_SYMBOL=SHFE.ni2607
# TQ_VERIFY_UPDATES=5

# Supabase PostgreSQL（迁移期作 SOURCE；切主后 DATABASE_URL 指向阿里云 RDS）
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require
# 推荐直接写 Session pooler（IPv4）：
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# 若仍写 db.*.supabase.co，cloud_sync 默认会自动改写为 pooler（可用 SUPABASE_FORCE_POOLER=0 关闭）
# SUPABASE_POOLER_REGION=ap-southeast-1
# 可选：登录用户 UUID，云同步写入 owner_id（RLS 读模型）
# SUPABASE_OWNER_ID=00000000-0000-0000-0000-000000000000
#
# --- 阿里云 RDS（云端主库，切主后 DATABASE_URL 也应指向这里）---
# 实例示例：pgm-uf6ro4p932k08bh8（PostgreSQL 17，上海）
# RDS_DATABASE_URL=postgresql://USER:PASS@pgm-xxxx.pg.rds.aliyuncs.com:5432/ignitequant?sslmode=disable
# 迁移时保留 Supabase 为源：
# SOURCE_DATABASE_URL=<原先的 Supabase pooler URL>
#   PYTHONPATH=src python tools/apply_rds_schema.py
#   PYTHONPATH=src python tools/migrate_supabase_to_rds.py --apply --truncate-target
#
# --- ECS deploy (tools/deploy_to_ecs.py) ---
# ECS_HOST=8.159.133.212
# ECS_USER=root
# ECS_PASSWORD=
# ECS_SSH_KEY=
# ECS_PATH=/opt/IgniteQuant
#   python tools/deploy_to_ecs.py
#   python tools/deploy_to_ecs.py --restart-sim
#   python tools/deploy_to_ecs.py --via-git --restart-sim
#
# Bucket: ignitequant（上海）
# 外网: https://oss-cn-shanghai.aliyuncs.com
#        ignitequant.oss-cn-shanghai.aliyuncs.com
# ECS 同地域内网（推荐写在 ECS .env）:
# OSS_ENDPOINT=https://oss-cn-shanghai-internal.aliyuncs.com
# OSS_BUCKET=ignitequant
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
#   pip install oss2
#   PYTHONPATH=src python tools/sync_files_to_oss.py --all
#
# 座舱登录账号存在 RDS 表 public.cockpit_users（推荐）
#   PYTHONPATH=. python tools/seed_cockpit_users.py
# 可选本机兜底单账号（无库时）：
# COCKPIT_USER=admin
# COCKPIT_PASSWORD=换成强密码
# COCKPIT_AUTH_SECRET=可选独立签名密钥
# COCKPIT_TOKEN_TTL_HOURS=168

# 座舱读路径（默认 cloud：家里/托管观看端只读云投影）
# SIM_DATA_SOURCE=cloud
# 本机调试读 data/runtime/*.sqlite：
# SIM_DATA_SOURCE=local
#
# 常驻托管（只读座舱，不依赖笔记本开着）：
#   docker build -t ignitequant-cockpit .
#   docker run --rm -p 8787:8787 -e DATABASE_URL=... -e SIM_DATA_SOURCE=cloud ignitequant-cockpit
#   浏览器打开 http://HOST:8787/#/sim
# 详见 docs/data_sovereignty_c.md「常驻托管只读座舱」
# SUPABASE_DB_HOST=db.xxxxx.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
#
# 应用 L3–L4 参考/研究表 + 产品租户表 + 座舱投影：
#   python tools/apply_supabase_schema.py
#   python tools/apply_supabase_schema.py --only sim_cockpit_projections
# 本地交易 outbox → 云端：模拟盘进程会自动同步（心跳/收盘）。
# 手动补推：
#   PYTHONPATH=src python tools/sync_outbox_to_supabase.py --db data/runtime/falcon_au_sim.sqlite
# 历史一次回填到投影表（换机后家里空白时）：
#   PYTHONPATH=src python tools/backfill_sim_projections_to_supabase.py --db data/runtime/falcon_au_sim.sqlite
#
# 外盘（COMEX/NYMEX）历史 → 本地 market_cache → Supabase market_bar_archive：
#   PYTHONPATH=src python tools/download_overseas_cache.py --ids gc,si,hg,cl --intervals "5m,1h,1d"
#   PYTHONPATH=src python tools/upload_overseas_cache_to_supabase.py --ids gc,si,hg,cl --durations "300,3600,86400"
# 归档 symbol：GC=F / SI=F / HG=F / CL=F；对照关系见 ref_overseas_pair（au↔gc, ag↔si）
#   PYTHONPATH=src python tools/backfill_sim_projections_to_supabase.py --db data/runtime/falcon_au_sim.sqlite
# 历史 K 线（market_cache）→ Supabase market_bar_archive：
#   PYTHONPATH=src python tools/upload_market_cache_to_supabase.py --ids au,ag,rb,fg
# 云端 K 线 → 本地 market_cache：
#   PYTHONPATH=src python tools/download_market_cache_from_supabase.py --ids au,ag,rb,fg
# 若本地无 CSV，先拉：
#   python tools/download_market_cache.py --ids au,ag,rb,fg --start 2024-01-01 --end 2025-12-31
# SQL：supabase/migrations/
# 数据主权：docs/data_sovereignty_c.md
